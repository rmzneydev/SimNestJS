# Port the API listens on
PORT=3000

# Valid API keys, comma-separated. These are fake: replace them in a real environment.
API_KEYS=key-demo-1,key-demo-2

# PostgreSQL database
# DB_HOST=localhost applies when running the API outside Docker; docker compose overrides it to "db".
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=request_db

# Request statuses, in workflow order. Only seeded when the "estados" table is empty.
STATUSES=PENDIENTE,EN_GESTION,RESUELTA
